---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Error 404">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-csh-blue">Page not found :(</h1>
    <p class="mt-2 text-slate-700">The requested page could not be found.</p>

    <div class="mx-auto mt-10 aspect-video max-w-xl overflow-hidden rounded-xl shadow-lg">
      <iframe
        class="h-full w-full"
        src="https://www.youtube.com/embed/t3otBjVZzT0?autoplay=1"
        title="404 easter egg"
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</Layout>
