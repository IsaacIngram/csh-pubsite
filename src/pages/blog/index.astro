---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { ASSETS_URL } from "../../lib/constants";
import { hashToHsl } from "../../lib/hash";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title="Blog" description="Stories and project write-ups from the members of Computer Science House." active="blog">
  <PageHeader title="Blog" subtitle="Project write-ups and stories from our members" />

  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="group flex flex-col overflow-hidden rounded-xl shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl">
        <div
          class="h-44 bg-cover bg-center"
          style={
            post.data.image
              ? `background-image: url(${ASSETS_URL}${post.data.image});`
              : `background-color: ${hashToHsl(post.data.title)};`
          }
        ></div>
        <div class="flex flex-1 flex-col gap-2 bg-white p-5">
          <h2 class="text-lg font-bold text-csh-blue group-hover:text-csh-pink">{post.data.title}</h2>
          <p class="text-sm text-slate-600 flex-1">{post.data.description}</p>
          <div class="flex items-center justify-between text-xs text-slate-500">
            <span>{post.data.author}</span>
            <span>{dateFormatter.format(post.data.date)}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</Layout>
