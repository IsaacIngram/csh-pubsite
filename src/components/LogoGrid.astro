---
import { ASSETS_URL } from "../lib/constants";
import { getLogoAsset } from "../lib/dominantColor";

interface Logo {
  name: string;
  url: string;
  logo: string;
}

interface Props {
  logos: Logo[];
}

const { logos } = Astro.props;

const items = await Promise.all(
  logos.map(async (item) => ({
    ...item,
    ...(await getLogoAsset(`${ASSETS_URL}${item.logo}`)),
  })),
);
---

<div class="grid grid-cols-2 justify-items-center gap-8 sm:grid-cols-3 lg:grid-cols-4">
  {items.map((item) => (
    <a
      href={item.url}
      target="_blank"
      rel="noopener"
      class="flex h-44 w-44 items-center justify-center overflow-hidden rounded-xl transition hover:shadow-md"
      style={`background-color: ${item.bg}`}
    >
      <img src={item.src} alt={item.name} class="h-full w-full object-contain p-4" loading="lazy" />
    </a>
  ))}
</div>
